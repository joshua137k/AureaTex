{
  "name": "aureatex-sync",
  "displayName": "AureaTeX Sync",
  "description": "Sincronização e Compilação para AureaTeX",
  "version": "0.1.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aureatex.sync",
        "title": "AureaTeX: Sincronizar Projeto (Push/Pull)"
      },
      {
        "command": "aureatex.setPassword",
        "title": "AureaTeX: Definir Password (guardada em segurança)"
      },
      {
        "command": "aureatex.logout",
        "title": "AureaTeX: Esquecer credenciais guardadas"
      }
    ],
    "keybindings": [
      {
        "command": "aureatex.sync",
        "key": "f6",
        "when": "editorTextFocus || !editorTextFocus"
      }
    ],
    "configuration": {
      "title": "AureaTeX",
      "properties": {
        "aureatex.apiUrl": {
          "type": "string",
          "default": "https://aurea.joshuadourado.pt",
          "description": "O URL do teu servidor AureaTeX (ex.: https://aurea.exemplo.pt)"
        },
        "aureatex.username": {
          "type": "string",
          "default": "",
          "description": "O teu utilizador do AureaTeX"
        },
        "aureatex.password": {
          "type": "string",
          "default": "",
          "description": "(Opcional) Password em texto simples. Recomendado: deixa vazio e usa o comando \"AureaTeX: Definir Password\", que a guarda no cofre do VS Code."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "mime-types": "^2.1.35"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^18.x",
    "@types/mime-types": "^2.1.1",
    "typescript": "^5.0.0"
  }
}